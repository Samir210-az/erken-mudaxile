{
  "rules": {
    "portal": {
      "courses": {
        ".read": true,
        ".write": "auth != null && root.child('portal/admins').child(auth.uid).val() === true"
      },
      "customers": {
        ".read": "auth != null && root.child('portal/admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('portal/admins').child(auth.uid).val() === true)",
          ".write": "auth != null && (auth.uid === $uid || root.child('portal/admins').child(auth.uid).val() === true)"
        }
      },
      "securityAlerts": {
        ".read": "auth != null && root.child('portal/admins').child(auth.uid).val() === true",
        ".write": "auth != null"
      },
      "admins": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "klinika": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "terapiya": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "saas_users": {
      ".read": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')",
      "$un": {
        ".read": "auth != null && (data.child('devices').child(auth.uid).exists() || ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin'))",
        ".write": "auth != null && (!data.exists() || ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin'))",
        "status": {
          ".validate": "newData.val() === 'pending' || ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')"
        },
        "pw": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 64"
        },
        "devices": {
          "$dev": {
            ".write": "auth != null && $dev === auth.uid",
            ".validate": "newData.child('pw').val() === newData.parent().parent().child('pw').val() && newData.child('ts').isNumber()"
          }
        }
      }
    },
    "aba_terapiya": {
      "registrations": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "menyu_analytics": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "an_site": {
      "news": {
        ".read": true,
        ".write": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')"
      },
      "team": {
        ".read": true,
        ".write": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')"
      },
      "about": {
        ".read": true,
        ".write": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')"
      },
      "reg": {
        ".read": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')",
        "$rid": {
          ".write": "auth != null && (!data.exists() || ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin'))",
          ".validate": "newData.hasChildren(['id','name','phone','program']) && newData.child('id').isNumber() && newData.child('name').isString() && newData.child('name').val().length <= 80 && newData.child('phone').isString() && newData.child('phone').val().matches(/^[0-9 +()-]{5,20}$/) && newData.child('program').isString() && newData.child('program').val().length <= 80 && (!newData.child('msg').exists() || (newData.child('msg').isString() && newData.child('msg').val().length <= 1000))"
        }
      }
    },
    "registrations": {
      "$tool": {
        ".read": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')",
        "$key": {
          ".read": "auth != null && (data.child('devices').child(auth.uid).exists() || ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin'))",
          ".write": "auth != null && (!data.exists() || ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin'))",
          ".validate": "$key.matches(/^994[0-9]{9}$/) && newData.child('phone').val() === '+' + $key && newData.child('pin').isString() && newData.child('pin').val().length >= 4 && newData.child('pin').val().length <= 12",
          "approved": {
            ".validate": "newData.isBoolean() && (newData.val() === false || ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin'))"
          },
          "adSoyad": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "isYeri": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "devices": {
            "$dev": {
              ".write": "auth != null && $dev === auth.uid",
              ".validate": "newData.child('pin').val() === newData.parent().parent().child('pin').val() && newData.child('ts').isNumber()"
            }
          }
        }
      }
    },
    "sirniyyat": {
      ".read": true,
      ".write": true
    },
    "ixtisas_test": {
      ".read": true,
      ".write": true
    },
    "plan_licenses": {
      ".read": "auth != null && auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true",
      ".write": "auth != null && auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['email', 'expiresAt', 'issuedAt']) && newData.child('expiresAt').isNumber() && newData.child('issuedAt').isNumber()"
      }
    },
    "plan_requests": {
      ".read": "auth != null && auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && auth.token.email_verified === true) || (auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true))",
        ".validate": "newData.hasChildren(['email', 'name', 'ts']) && newData.child('email').val() === auth.token.email && newData.child('name').isString() && newData.child('name').val().length <= 120 && newData.child('ts').isNumber()"
      }
    },
    "plan_bank": {
      ".read": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('plan_licenses').child(auth.uid).child('expiresAt').val() > now)",
      ".write": "auth != null && auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true"
    },
    "plan_children": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$ck": {
          ".write": "auth != null && auth.uid === $uid && root.child('plan_licenses').child($uid).child('expiresAt').val() > now",
          ".validate": "newData.hasChildren(['json', 'mt']) && newData.child('json').isString() && newData.child('json').val().length <= 3000000 && newData.child('mt').isNumber()"
        }
      }
    },
    "lisenziya_sorgulari": {
      "autism": {
        ".read": true,
        "$id": {
          ".write": true,
          ".validate": "newData.hasChildren(['ad','soyad','merkez','telefon','ts']) && newData.child('ad').isString() && newData.child('ad').val().length <= 40 && newData.child('soyad').isString() && newData.child('soyad').val().length <= 40 && newData.child('merkez').isString() && newData.child('merkez').val().length <= 60 && newData.child('telefon').isString() && newData.child('telefon').val().length <= 9 && newData.child('ts').isNumber()"
        }
      }
    },
    "lisenziya_cihazlar": {
      "autism": {
        "$id": {
          ".read": "$id.matches(/^[a-z0-9]{5}$/)",
          "$slot": {
            ".write": "$id.matches(/^[a-z0-9]{5}$/) && ($slot === 'd1' || $slot === 'd2' || $slot === 'd3') && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['dev','ts']) && newData.child('dev').isString() && newData.child('dev').val().length <= 40 && newData.child('ts').isNumber() && (!newData.child('ua').exists() || (newData.child('ua').isString() && newData.child('ua').val().length <= 40))",
            "$other": {
              ".validate": "$other === 'dev' || $other === 'ts' || $other === 'ua'"
            }
          }
        }
      }
    },
    "users": {
      ".read": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || (auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')",
        "rol": {
          ".validate": "newData.isString() && (newData.val() === 'valideyn' || newData.val() === 'terapevt' || newData.val() === 'admin') && ( (!data.exists() && newData.val() === 'valideyn') || (data.exists() && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin' || newData.val() === data.val())) )"
        },
        "tier": {
          ".validate": "newData.val() === 'pulsuz' || (newData.val() === 'premium' && (data.val() === 'premium' || ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin') || (newData.parent().child('premiumKod').isString() && newData.parent().parent().parent().child('premiumKodlar').child(newData.parent().child('premiumKod').val()).child('istifadeBy').val() === $uid)))"
        },
        "premiumKod": {
          ".validate": "newData.isString() && newData.val().length <= 24 && newData.parent().parent().parent().child('premiumKodlar').child(newData.val()).child('istifadeBy').val() === $uid"
        }
      }
    },
    "children": {
      ".read": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')",
      "$childId": {
        ".read": "auth != null && ( (auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin' || data.child('parentIds').child(auth.uid).exists() || data.child('therapistIds').child(auth.uid).exists() )",
        ".write": "auth != null && ( (auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin' || data.child('therapistIds').child(auth.uid).exists() || data.child('parentIds').child(auth.uid).exists() || ( !data.exists() && newData.child('parentIds').child(auth.uid).exists() ) )",
        ".validate": "newData.hasChildren(['profil', 'raziliq'])",
        "raziliq": {
          ".validate": "newData.child('verildi').isBoolean()"
        }
      }
    },
    "userChildren": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')",
        "$childId": {
          ".write": "auth != null && ( auth.uid === $uid || (auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin' || root.child('children').child($childId).child('therapistIds').child(auth.uid).exists() )",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "seanslar": {
      ".indexOn": [
        "childId"
      ],
      "$seansId": {
        ".read": "auth != null && ( (auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin' || root.child('children').child(data.child('childId').val()).child('parentIds').child(auth.uid).exists() || root.child('children').child(data.child('childId').val()).child('therapistIds').child(auth.uid).exists() )",
        ".write": "auth != null && ( (auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin' || root.child('children').child(newData.child('childId').val()).child('therapistIds').child(auth.uid).exists() )",
        ".validate": "newData.hasChild('childId')"
      },
      ".read": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')"
    },
    "meqsedKitabxanasi": {
      ".read": "auth != null",
      ".indexOn": [
        "domen"
      ],
      "$meqsedId": {
        ".write": "auth != null && ( (auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin' || root.child('users').child(auth.uid).child('rol').val() === 'terapevt' )",
        ".validate": "newData.hasChildren(['domen', 'ad'])",
        "domen": {
          ".validate": "newData.isString() && (newData.val() === 'nitq' || newData.val() === 'sosial' || newData.val() === 'davranis' || newData.val() === 'ozunexidmet' || newData.val() === 'idrak' || newData.val() === 'boyuk-motorika' || newData.val() === 'ince-motorika')"
        }
      }
    },
    "premiumKodlar": {
      ".read": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin')",
      "$kod": {
        ".read": "auth != null",
        ".write": "auth != null && ((auth.token.email === 'samir.akhundoff@gmail.com' && auth.token.email_verified === true) || root.child('users').child(auth.uid).child('rol').val() === 'admin' || (!data.child('istifadeBy').exists() && newData.child('istifadeBy').val() === auth.uid && data.child('valideynUid').val() === auth.uid && now < data.child('bitmeTarixi').val()))"
      }
    }
  }
}
